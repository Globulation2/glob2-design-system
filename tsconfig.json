{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "rootDir": "src"
  },
  "include": [
    "src/*.tsx",
    "src/*.ts",
    "src/*.js"
  ]
}
